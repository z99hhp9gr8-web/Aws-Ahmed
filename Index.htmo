* {
margin: 0;
padding: 0;
box-sizing: border-box;
font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
}
body {
background-color: var(--dark-color);
color: var(--text-color);
line-height: 1.6;
scroll-behavior: smooth;
}
header {
background-color: var(--dark-color);
border-bottom: 2px solid var(--primary-color);
padding: 1rem 0;
position: sticky;
top: 0;
z-index: 1000;
}
.container {
max-width: 1200px;
margin: 0 auto;
padding: 0 2rem;
display: flex;
justify-content: space-between;
align-items: center;
}
.logo h1 {
color: var(--primary-color);
font-size: 1.8rem;
text-transform: uppercase;
letter-spacing: 1px;
font-weight: 700;
}
nav a {
color: var(--text-color);
margin-left: 2rem;
text-decoration: none;
font-weight: 600;
text-transform: uppercase;
font-size: 0.9rem;
transition: color 0.3s ease;
}
nav a:hover, nav a.active {
color: var(--primary-color);
}
.hero {
background: linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.7)), url('hero_placeholder.jpg') no-repeat center center/cover;
height: 70vh;
display: flex;
justify-content: center;
align-content: center;
align-items: center;
text-align: center;
color: #fff;
}
.hero-content h2 {
font-size: 3.5rem;
margin-bottom: 1rem;
text-transform: uppercase;
color: #fff;
text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
}
.hero-content p {
font-size: 1.3rem;
margin-bottom: 2rem;
color: var(--text-color);
}
.btn {
display: inline-block;
background-color: var(--primary-color);
color: var(--dark-color);
padding: 0.8rem 2rem;
text-decoration: none;
font-weight: bold;
text-transform: uppercase;
border-radius: 5px;
transition: background-color 0.3s ease;
}
.btn:hover {
background-color: var(--accent-color);
}
section {
padding: 5rem 2rem;
}
.section-title {
text-align: center;
font-size: 2.5rem;
margin-bottom: 3rem;
text-transform: uppercase;
color: #fff;
position: relative;
}
.section-title::after {
content: '';
display: block;
width: 50px;
height: 3px;
background-color: var(--primary-color);
margin: 10px auto 0;
}
.about-content {
display: flex;
align-items: center;
gap: 3rem;
flex-wrap: wrap;
}
.about-text {
flex: 1;
min-width: 300px;
}
.about-image {
flex: 1;
min-width: 300px;
height: 400px;
background-color: var(--secondary-color);
border-radius: 5px;
display: flex;
align-items: center;
justify-content: center;
border: 2px solid var(--secondary-color);
background: url('about_placeholder.jpg') no-repeat center center/cover;
}
.services-grid {
display: grid;
grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
gap: 2rem;
}
.service-card {
background-color: var(--secondary-color);
padding: 3rem;
border-radius: 5px;
text-align: center;
transition: transform 0.3s ease, box-shadow 0.3s ease;
border: 1px solid #444;
}
.service-card:hover {
transform: translateY(-5px);
box-shadow: 0 5px 15px rgba(255, 204, 0, 0.2);
}
.service-card h3 {
color: var(--primary-color);
margin-bottom: 1.5rem;
font-size: 1.5rem;
}
.contact-section {
background-color: #0c0c0c;
}
.contact-container {
max-width: 800px;
margin: 0 auto;
text-align: center;
}
.contact-info {
display: flex;
justify-content: space-around;
flex-wrap: wrap;
gap: 2rem;
margin-top: 3rem;
}
.contact-info div {
flex: 1;
min-width: 200px;
}
.contact-info strong {
display: block;
color: var(--primary-color);
margin-bottom: 0.5rem;
font-size: 1.1rem;
}
footer {
text-align: center;
padding: 2rem;
background-color: var(--dark-color);
font-size: 0.9rem;
color: #777;
border-top: 1px solid var(--secondary-color);
}
@media (max-width: 768px) {
.hero-content h2 {
font-size: 2.5rem;
}
.nav {
display: none;
}
}
</style>
</head>
<body>
<header>
<div class="container">
<div class="logo">
<h1>A & A Auto Body Shop and Paint</h1>
</div>
<nav>
<a href="#about" class="active">About Us</a>
<a href="#services">Services</a>
<a href="#contact">Contact</a>
</nav>
</div>
</header>
<section class="hero">
<div class="hero-content">
<h2>Get Your Car Looking Brand New</h2>
<p>Premium Collision Repair and Custom Painting Services</p>
<a href="#contact" class="btn">Get a Free Estimate</a>
</div>
</section>
<section id="about">
<div class="container">
<div class="about-content">
<div class="about-text">
<h2 class="section-title">About Us</h2>
<p>Welcome to A & A Auto Body Shop and Paint, your trusted destination for premium auto body repair and custom painting. With years of experience in the industry, our dedicated team of technicians restores vehicles to their pre-accident condition using state-of-the-art equipment and high-quality materials. We pride ourselves on attention to detail, excellent customer service, and reliable results that get you back on the road safely.</p>
</div>
<div class="about-image">
<!-- Placeholder for your "About Us" image -->
</div>
</div>
</div>
</section>
<section id="services" style="background-color: #1a1a1a;">
<div class="container">
<h2 class="section-title">Our Services</h2>
<div class="services-grid">
<div class="service-card">
<h3>Collision Repair</h3>
<p>Expert structural and cosmetic repair following any accident or damage. We work with all insurance.</p>
</div>
<div class="service-card">
<h3>Auto Painting</h3>
<p>Precision color matching and premium paint finishes for a flawless, showroom-quality look.</p>
</div>
<div class="service-card">
<h3>Dents & Scratches</h3>
<p>Removal of unsightly dents, dings, and scratches without a trace, using advanced techniques.</p>
</div>
</div>
</div>
</section>
<section id="contact" class="contact-section">
<div class="container contact-container">
<h2 class="section-title">Contact Us</h2>
<p>Ready to get your vehicle looking its best? Reach out to us today for an estimate or consultation.</p>
<div class="contact-info">
<div>
<strong>Phone</strong>
<p>(555) 123-4567</p>
</div>
<div>
<strong>Email</strong>
<p>info@aaautobody.com</p>
</div>
<div>
<strong>Address</strong>
<p>123 Repair Lane, Automotive City, AC 90210</p>
</div>
</div>
</div>
</section>
<footer>
<p>© 2026 A & A Auto Body Shop and Paint. All Rights Reserved.</p>
</footer>
</body>
</html>
